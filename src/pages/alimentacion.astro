---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  Printer,
  HeartPulse,
  Utensils,
  Syringe,
  Check,
  X,
  Sparkles,
  Flame,
  Salad,
  Phone,
} from "@lucide/astro";
import { absoluteUrl } from "../lib/site";
import "../styles/alimentacion.css";

const pageUrl = absoluteUrl("alimentacion/");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: "Guía de alimentación para la diabetes | GlucoLuna",
  url: pageUrl,
  description:
    "10 consejos clínicos sobre la alimentación para personas con diabetes basados en el Servicio Extremeño de Salud (SES) y GEDAPS. Formato imprimible en 2 hojas A4.",
  inLanguage: "es",
  author: {
    "@type": "Person",
    name: "Antonio Horrillo",
    url: "https://github.com/antoniohh",
  },
  isAccessibleForFree: true,
  dateModified: "2026-11-01",
  audience: {
    "@type": "Patient",
  },
  about: {
    "@type": "MedicalCondition",
    name: "Diabetes",
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${absoluteUrl("")}#website`,
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: absoluteUrl(""),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Guía de alimentación",
        item: pageUrl,
      },
    ],
  },
};
---

<BaseLayout
  title="Guía de alimentación para la diabetes | GlucoLuna"
  description="10 consejos prácticos sobre alimentación para personas con diabetes: qué comer a lo largo del día, qué alimentos preferir y cuáles evitar. Letra grande y formato imprimible en A4."
  canonicalPath="alimentacion/"
  active="alimentacion"
  mainClass="nutrition-page"
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="container">
    <PageHeader
      kicker="Guía práctica para casa"
      title="10 Consejos sobre la alimentación"
      lead="Pautas claras para el día a día basadas en el manual clínico del Servicio Extremeño de Salud (SES). Imprimible en 2 hojas A4 para tener en la cocina o la nevera."
    >
      <button
        class="btn btn--primary w-full min-[900px]:w-auto"
        type="button"
        id="print-guide"
      >
        <Printer size={19} aria-hidden="true" />
        Imprimir guía en A4
      </button>
    </PageHeader>
  </div>

  <p class="container nutrition-hint no-print">
    Guía orientativa del Servicio Extremeño de Salud (SES). Imprime en 2 hojas A4 vertical con «Gráficos de fondo» activado.
  </p>

  <div class="guide-pages" id="guide-pages">
    <!-- ================= HOJA 1: 10 CONSEJOS CLÍNICOS ================= -->
    <section class="page" aria-label="Hoja 1: 10 Consejos clínicos sobre la alimentación">
      <header class="page-head">
        <div class="page-kicker">Pautas clínicas · Hoja 1 de 2</div>
        <h2 class="page-title">10 Consejos sobre la alimentación</h2>
        <p class="page-lead">
          Pautas del Servicio Extremeño de Salud (SES) y GEDAPS. Una alimentación sana, equilibrada y compartida por toda la familia.
        </p>
      </header>

      <!-- Ficha de horarios -->
      <div class="personal" aria-label="Mis horarios de comida">
        <div class="personal__item">
          <span>Mi desayuno:</span>
          <span class="personal__line"></span>
        </div>
        <div class="personal__item">
          <span>Mi comida:</span>
          <span class="personal__line"></span>
        </div>
        <div class="personal__item">
          <span>Mi cena:</span>
          <span class="personal__line"></span>
        </div>
        <div class="personal__item">
          <span>Enfermera/o:</span>
          <span class="personal__line"></span>
        </div>
      </div>

      <!-- Las 3 reglas de oro -->
      <h3 class="sec-title">
        <HeartPulse size={18} aria-hidden="true" />
        Las 3 reglas de oro para empezar
      </h3>

      <div class="golden-rules">
        <!-- Consejo 1 -->
        <article class="rule-box">
          <div class="rule-box__top">
            <span class="rule-box__badge rule-box__badge--1" aria-hidden="true">1</span>
            <h3>De 3 a 6 comidas al día</h3>
          </div>
          <p>
            Reparta las comidas a lo largo del día. Es <strong>fundamental respetar los horarios</strong> para evitar hipoglucemias o picos.
          </p>
          <ul>
            <li>Horarios regulares todos los días.</li>
            <li>No se salte ninguna comida prevista.</li>
            <li>Cantidades similares de alimentos cada día.</li>
          </ul>
        </article>

        <!-- Consejo 2 -->
        <article class="rule-box">
          <div class="rule-box__top">
            <span class="rule-box__badge rule-box__badge--2" aria-hidden="true">2</span>
            <h3>Evite azúcares rápidos</h3>
          </div>
          <p>
            Pasan directamente a la sangre y provocan subidas bruscas de glucosa difíciles de controlar.
          </p>
          <ul>
            <li><strong>Elimine:</strong> azúcar, miel, zumos y refrescos.</li>
            <li><strong>Evite:</strong> bollería, helados y dulces.</li>
            <li><strong>Cuidado:</strong> fructosa «para personas con diabetes».</li>
          </ul>
        </article>

        <!-- Consejo 3 -->
        <article class="rule-box">
          <div class="rule-box__top">
            <span class="rule-box__badge rule-box__badge--3" aria-hidden="true">3</span>
            <h3>Controle el colesterol</h3>
          </div>
          <p>
            Disminuya grasas saturadas y trans para proteger el corazón y la circulación sanguínea.
          </p>
          <ul>
            <li><strong>Siempre aceite de oliva:</strong> en crudo y para guisar.</li>
            <li><strong>Limite:</strong> mantequilla, tocino y manteca.</li>
            <li><strong>Elimine:</strong> fritos, rebozados y precocinados.</li>
          </ul>
        </article>
      </div>

      <!-- Alimentación de un día cualquiera (Consejos 4 a 10) -->
      <h3 class="sec-title">
        <Utensils size={18} aria-hidden="true" />
        Alimentación de un día cualquiera (los 7 grupos)
      </h3>

      <div class="day-grid">
        <!-- Consejo 4 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">4</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Hidratos de absorción lenta con fibra</h4>
            </div>
            <p class="day-item__desc">
              En todas las comidas principales: aportan energía constante. Priorice <strong>legumbres</strong> (lentejas, garbanzos, alubias) y cereales integrales. Consuma en <em>menor cantidad</em> pasta, pan, arroz o patata.
            </p>
            <span class="day-item__pill day-item__pill--blue">Legumbres · Integrales · Energía lenta</span>
          </div>
        </article>

        <!-- Consejo 5 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">5</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Verdura y ensalada</h4>
            </div>
            <p class="day-item__desc">
              <strong>Un plato de verdura y un plato de ensalada</strong> al día. Aportan vitaminas, agua y fibra vegetal saciante. Combine diferentes colores (verde, rojo, naranja, morado) en la comida y en la cena.
            </p>
            <span class="day-item__pill day-item__pill--green">1 plato de verdura + 1 ensalada</span>
          </div>
        </article>

        <!-- Consejo 6 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">6</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Fruta: 2 a 3 piezas medianas</h4>
            </div>
            <p class="day-item__desc">
              Consuma 2 o 3 frutas medianas al día, <strong>siempre enteras y tras las comidas</strong>. <em>Nunca en zumo</em>: al exprimir o triturar la fruta sus azúcares quedan libres y pasan de golpe a la sangre.
            </p>
            <span class="day-item__pill day-item__pill--green">Siempre entera · Nunca en zumo</span>
          </div>
        </article>

        <!-- Consejo 7 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">7</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Carne o pescado: 2 raciones pequeñas</h4>
            </div>
            <p class="day-item__desc">
              <strong>120-130 g de carne o 150 g de pescado</strong> al día. Dé prioridad al pescado (al menos 3 veces por semana) y a las carnes blancas y magras (pollo, pavo, conejo) frente a las carnes rojas y grasas.
            </p>
            <span class="day-item__pill day-item__pill--blue">Carne 120 g · Pescado 150 g</span>
          </div>
        </article>

        <!-- Consejo 8 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">8</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Lácteos desnatados o semi</h4>
            </div>
            <p class="day-item__desc">
              <strong>Dos vasos grandes al día</strong> de leche desnatada para aportar calcio sin grasas perjudiciales. <em>Equivalencia práctica:</em> 1 vaso = <strong>2 yogures desnatados</strong> o <strong>100 g de queso fresco</strong>.
            </p>
            <span class="day-item__pill day-item__pill--blue">2 vasos de leche o equivalentes</span>
          </div>
        </article>

        <!-- Consejo 9 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">9</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Grasas saludables</h4>
            </div>
            <p class="day-item__desc">
              <strong>4 cucharadas soperas al día de aceite de oliva</strong> (para cocinar y en crudo). Añada <strong>30 g de frutos secos</strong> crudos (nueces, almendras sin freír ni salar) 3 días por semana por protección cardiovascular.
            </p>
            <span class="day-item__pill day-item__pill--blue">4 cucharadas aceite · 30 g frutos secos</span>
          </div>
        </article>

        <!-- Consejo 10 -->
        <article class="day-item">
          <span class="day-item__num" aria-hidden="true">10</span>
          <div class="day-item__body">
            <div class="day-item__head">
              <h4 class="day-item__title">Alcohol y café</h4>
            </div>
            <p class="day-item__desc">
              <strong>Consulte siempre con su médico:</strong> el alcohol en ayunas o con medicación puede provocar <em>hipoglucemias graves</em>. Café solo o con leche desnatada, siempre sin azúcar. Evite licores dulces.
            </p>
            <span class="day-item__pill day-item__pill--amber">Consultar con profesional sanitario</span>
          </div>
        </article>

        <!-- Llamada insulina -->
        <div class="insulin-box">
          <Syringe size={24} aria-hidden="true" />
          <div>
            <h4>Importante si usa insulina</h4>
            <p>
              No se salte comidas tras administrarse insulina rápida o mezclas. Mantenga cantidades similares de hidratos cada día para facilitar el ajuste exacto de su dosis.
            </p>
          </div>
        </div>
      </div>

      <footer class="page-footer">
        <span>GlucoLuna · Guía clínica de alimentación para la diabetes</span>
        <span>Página 1 de 2</span>
      </footer>
    </section>

    <!-- ================= HOJA 2: CESTA DE LA COMPRA Y COCINA ================= -->
    <section class="page" aria-label="Hoja 2: Cesta de la compra y cocina">
      <header class="page-head">
        <div class="page-kicker">Cesta de la compra y cocina · Hoja 2 de 2</div>
        <h2 class="page-title">¿Qué alimentos preferir y cuáles evitar?</h2>
        <p class="page-lead">
          Tabla visual para tener en la cocina y repasar antes de ir a comprar o preparar las comidas familiares.
        </p>
      </header>

      <!-- Comparativa Preferir vs Evitar -->
      <div class="comp-grid">
        <!-- Columna PREFERIR -->
        <div class="comp-column comp-column--prefer">
          <div class="comp-column__head">
            <Check size={22} aria-hidden="true" />
            <h3>Alimentos a preferir</h3>
          </div>
          <ul class="comp-list">
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Pescado variado:</strong> al menos 3 veces por semana (pescado blanco y azul por sus ácidos grasos omega-3).</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Carnes blancas y magras:</strong> pollo, pavo, conejo y ternera magra sin piel ni grasa visible.</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Aceite de oliva virgen:</strong> como grasa principal para aliñar en crudo y para cocinar los alimentos.</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Cocciones saludables:</strong> plancha, horno, vapor, papillote o hervido. Evita añadir grasas innecesarias.</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Lácteos desnatados o semi:</strong> leche descremada, yogures 0% y queso fresco bajo en grasas.</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Legumbres y fibra vegetal:</strong> lentejas, garbanzos, alubias, verduras variadas y cereales integrales.</span>
            </li>
            <li>
              <Check size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Agua como bebida principal:</strong> infusiones sin azúcar y caldos desgrasados. Manténgase bien hidratado.</span>
            </li>
          </ul>
        </div>

        <!-- Columna EVITAR -->
        <div class="comp-column comp-column--avoid">
          <div class="comp-column__head">
            <X size={22} aria-hidden="true" />
            <h3>Alimentos a evitar o limitar</h3>
          </div>
          <ul class="comp-list">
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Embutidos y carnes procesadas:</strong> chorizo, salchichón, patés, beicon, mortadela y salchichas industriales.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Carne roja y grasa animal:</strong> limitar a no más de 1 vez a la semana y retirar siempre la grasa visible.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Grasas saturadas y trans:</strong> mantequilla, margarinas, manteca de cerdo, aceite de palma y de coco.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Fritos y rebozados:</strong> croquetas, empanados y frituras que absorben gran cantidad de aceite perjudicial.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Lácteos enteros y quesos grasos:</strong> quesos curados, semicurados, quesos fundidos para untar y nata.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Azúcares rápidos y dulces:</strong> bollería industrial, pasteles, zumos (incluso naturales), refrescos y miel.</span>
            </li>
            <li>
              <X size={16} class="comp-icon" aria-hidden="true" />
              <span><strong>Alcohol de alta graduación:</strong> licores dulces, chupitos y combinados. Pueden provocar hipoglucemias.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Técnicas de cocinado ligero -->
      <div class="cooking-section">
        <h3 class="sec-title">
          <Sparkles size={18} aria-hidden="true" />
          Preparación y cocina saludable
        </h3>

        <div class="cooking-grid">
          <div class="cooking-card">
            <h4>
              <Flame size={16} aria-hidden="true" />
              Cocina sin grasas
            </h4>
            <p>
              Cocine a la <strong>plancha, al vapor, al horno o en papillote</strong>. Utilice sartenes antiadherentes y mida el aceite con cuchara para no excederse.
            </p>
          </div>

          <div class="cooking-card">
            <h4>
              <Utensils size={16} aria-hidden="true" />
              Más sabor sin sal
            </h4>
            <p>
              Potencie el sabor con <strong>ajo, cebolla, limón, vinagre y hierbas aromáticas</strong> (orégano, perejil, laurel, tomillo o pimentón) para cuidar la tensión.
            </p>
          </div>

          <div class="cooking-card">
            <h4>
              <Salad size={16} aria-hidden="true" />
              El método del plato
            </h4>
            <p>
              En la comida y la cena: <strong>½ plato de verduras o ensalada</strong>, <strong>¼ de proteínas</strong> (pescado o carne magra) y <strong>¼ de hidratos lentos</strong>.
            </p>
          </div>
        </div>
      </div>

      <!-- Mis teléfonos de contacto -->
      <div class="contacts-section">
        <h3 class="sec-title">
          <Phone size={18} aria-hidden="true" />
          Mis teléfonos de salud
        </h3>

        <div class="contacts-grid">
          <div class="contact-item">
            <span>Centro de salud:</span>
            <span class="contact-item__line"></span>
          </div>
          <div class="contact-item">
            <span>Médico/a:</span>
            <span class="contact-item__line"></span>
          </div>
          <div class="contact-item">
            <span>Enfermera/o:</span>
            <span class="contact-item__line"></span>
          </div>
          <div class="contact-item">
            <span>Farmacia o familiar:</span>
            <span class="contact-item__line"></span>
          </div>
        </div>
      </div>

      <!-- Créditos clínicos y aviso -->
      <div class="clinical-footer-note">
        <strong>Fuente clínica:</strong> Adaptado del manual <em>«10 Consejos para la persona con diabetes sobre la alimentación»</em> (GEDAPS), coordinado por I. Bobé, C. Lecumberri y J.F. Cano. Distribuido por el <strong>Servicio Extremeño de Salud (SES)</strong>. Esta guía es una herramienta de apoyo y no sustituye la consulta médica ni la pauta individualizada de su equipo de salud.
      </div>

      <footer class="page-footer">
        <span>GlucoLuna · Guía clínica de alimentación para la diabetes</span>
        <span>Página 2 de 2</span>
      </footer>
    </section>
  </div>

  <script>
    import "../scripts/guia.js";
  </script>
</BaseLayout>

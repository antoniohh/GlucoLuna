---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/site";
import { House, CalendarDays, BookOpen } from "@lucide/astro";
---

<BaseLayout
  title="Página no encontrada | GlucoLuna"
  description="La página que buscas no existe. Vuelve al inicio, abre el calendario o consulta la guía de pinchazo."
  canonicalPath={null}
  robots="noindex,follow"
>
  <div class="container grid min-h-[calc(100vh-var(--header-h))] place-items-center py-12">
    <div class="w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl sm:p-12">
      <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.14em] text-[#1e3a8a]">
        Error 404
      </p>
      <h1 class="mb-3 text-balance text-4xl font-extrabold tracking-tight">
        Esta página no existe
      </h1>
      <p class="mx-auto max-w-lg text-slate-600">
        Puede que el enlace esté mal escrito o que la página se haya movido. Vuelve al inicio,
        abre el calendario o consulta la guía de pinchazo.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a class="btn btn--primary w-full sm:w-auto" href={withBase("")}>
          <House size={18} aria-hidden="true" />
          Volver al inicio
        </a>
        <a class="btn btn--secondary w-full sm:w-auto" href={withBase("calendario/")}>
          <CalendarDays size={18} aria-hidden="true" />
          Abrir calendario
        </a>
        <a class="btn btn--secondary w-full sm:w-auto" href={withBase("guia-pinchazo/")}>
          <BookOpen size={18} aria-hidden="true" />
          Ver la guía
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

---
import { withBase } from "../lib/site";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <a class="brand" href={withBase("")} aria-label="GlucoLuna, inicio">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M14.5 2.8a8.6 8.6 0 1 0 6.7 12.7 9.5 9.5 0 0 1-6.7-12.7Z" fill="currentColor"></path>
            <path d="M17.2 15.1s2.1 2.3 2.1 3.6a2.1 2.1 0 0 1-4.2 0c0-1.3 2.1-3.6 2.1-3.6Z" fill="#bfdbfe"></path>
          </svg>
        </span>
        <span class="brand__text">
          <span class="brand__name">GlucoLuna</span>
          <span class="brand__tag">Glucosa nocturna</span>
        </span>
      </a>
      <p class="site-footer__about">
        Calendario y guía visual para el control nocturno de la glucosa. Para imprimir
        y tener a mano en casa.
      </p>
    </div>

    <div>
      <p class="site-footer__title">Herramientas</p>
      <ul class="site-footer__links">
        <li><a href={withBase("calendario/")}>Calendario mensual</a></li>
        <li><a href={withBase("guia-pinchazo/")}>Guía de pinchazo</a></li>
        <li><a href={withBase("alimentacion/")}>Guía de alimentación</a></li>
      </ul>
    </div>

    <div>
      <p class="site-footer__title">Información</p>
      <ul class="site-footer__links">
        <li><a href={`${withBase("")}#como-funciona`}>Cómo funciona</a></li>
        <li><a href={`${withBase("")}#preguntas`}>Preguntas frecuentes</a></li>
        <li><a href={`${withBase("")}#aviso-medico`}>Aviso médico</a></li>
        <li><a href={withBase("cookies/")}>Política de cookies</a></li>
        <li><button type="button" data-open-cookie-preferences>Preferencias de cookies</button></li>
      </ul>
    </div>

    <div>
      <p class="site-footer__title">Red de Proyectos</p>
      <ul class="site-footer__links">
        <li>
          <a
            href="https://luz.antoniohorrillo.com/"
            title="Precio de la luz hoy en Extremadura hora a hora (PVPC)"
          >
            ⚡ Luz Extremadura
          </a>
        </li>
        <li>
          <a
            href="https://combustible.antoniohorrillo.com/"
            title="Gasolineras más baratas de Extremadura hoy"
          >
            ⛽ Combustible Extremadura
          </a>
        </li>
        <li>
          <a
            href="https://embalses.antoniohorrillo.com/"
            title="Nivel de agua y embalses de Extremadura"
          >
            💧 Embalses Extremadura
          </a>
        </li>
        <li style="margin-top: 4px; padding-top: 6px; border-top: 1px solid rgba(148, 163, 184, 0.2);">
          <a
            href="https://antoniohorrillo.com/"
            target="_blank"
            rel="noopener noreferrer"
            style="font-size: 12.5px; opacity: 0.85; text-decoration: underline;"
          >
            antoniohorrillo.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>
      <strong>Aviso:</strong> GlucoLuna es una herramienta de apoyo. No sustituye el consejo médico ni la formación de tu enfermera. Ante una urgencia, llama al 112.&nbsp;
      © 2026 GlucoLuna · Creado por&nbsp;<a href="https://github.com/antoniohh" rel="author">Antonio Horrillo</a> ·&nbsp;<a href="https://github.com/antoniohh/GlucoLuna/blob/main/LICENSE">Licencia MIT</a>
    </p>
  </div>
</footer>

---
import { Menu, X } from "@lucide/astro";
import { withBase } from "../lib/site";

interface Props {
  active?: "inicio" | "calendario" | "guia" | null;
}

const { active = null } = Astro.props;

const links = [
  { id: "inicio", label: "Inicio", href: withBase("") },
  { id: "calendario", label: "Calendario", href: withBase("calendario/") },
  { id: "guia", label: "Guía de pinchazo", href: withBase("guia-pinchazo/") },
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={withBase("")} aria-label="GlucoLuna, inicio">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M14.5 2.8a8.6 8.6 0 1 0 6.7 12.7 9.5 9.5 0 0 1-6.7-12.7Z" fill="currentColor"></path>
          <path d="M17.2 15.1s2.1 2.3 2.1 3.6a2.1 2.1 0 0 1-4.2 0c0-1.3 2.1-3.6 2.1-3.6Z" fill="#bfdbfe"></path>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">GlucoLuna</span>
        <span class="brand__tag">Glucosa nocturna</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          class="main-nav__link"
          href={link.href}
          aria-current={active === link.id ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="menu-toggle__open" aria-hidden="true"><Menu size={22} /></span>
      <span class="menu-toggle__close" aria-hidden="true"><X size={22} /></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav class="mobile-menu__nav" aria-label="Navegación móvil">
      {links.map((link) => (
        <a
          class="mobile-menu__link"
          href={link.href}
          aria-current={active === link.id ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

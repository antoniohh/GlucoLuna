---
interface Props {
  kicker: string;
  title: string;
  lead: string;
}

const { kicker, title, lead } = Astro.props;
---

<header class="page-header mb-6 flex flex-col items-start justify-between gap-5 min-[900px]:flex-row">
  <div class="min-w-0 max-w-[780px]">
    <p class="mb-2 text-xs font-extrabold uppercase tracking-[0.12em] text-[#1e3a8a]">
      {kicker}
    </p>
    <h1 class="mb-2.5 text-[clamp(1.9rem,3.6vw,2.75rem)] font-extrabold leading-[1.12] tracking-tight">
      {title}
    </h1>
    <p class="max-w-[720px] text-[15.5px] leading-relaxed text-[#4b5a6e]">
      {lead}
    </p>
  </div>

  <div class="flex w-full flex-wrap gap-2.5 min-[900px]:w-auto">
    <slot />
  </div>
</header>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { absoluteUrl, withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  ogType?: "website" | "article";
  active?: "inicio" | "calendario" | "guia" | "alimentacion" | null;
  mainClass?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonicalPath = "",
  ogType = "website",
  active = null,
  mainClass,
  robots = "index,follow",
  jsonLd = null,
} = Astro.props;

const canonical = canonicalPath === null ? null : absoluteUrl(canonicalPath);
const ogImage = absoluteUrl("assets/og-image.png");
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google Consent Mode v2 & Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      var savedConsent = null;
      try {
        savedConsent = localStorage.getItem('glucoluna_cookie_consent');
      } catch (e) {}

      var isGranted = savedConsent === 'granted';

      gtag('consent', 'default', {
        'analytics_storage': isGranted ? 'granted' : 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      gtag('js', new Date());
      gtag('config', 'G-PZ3W1DHYWT', {
        'anonymize_ip': true
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PZ3W1DHYWT"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e3a8a" />
    <meta name="robots" content={robots} />
    <meta name="application-name" content="GlucoLuna" />
    <meta name="author" content="Antonio Horrillo (GlucoLuna)" />
    <meta name="generator" content={Astro.generator} />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="GlucoLuna" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GlucoLuna, calendario de glucosa y guía de pinchazo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase("assets/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("assets/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header active={active} />
    <main id="contenido" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script>
      import "../scripts/ui.js";
    </script>
  </body>
</html>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import NetworkBar from "../components/NetworkBar.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import InstallPrompt from "../components/InstallPrompt.astro";
import { absoluteUrl, withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | null;
  ogType?: "website" | "article";
  active?: "inicio" | "calendario" | "guia" | "alimentacion" | null;
  mainClass?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonicalPath = "",
  ogType = "website",
  active = null,
  mainClass,
  robots = "index,follow",
  jsonLd = null,
} = Astro.props;

const canonical = canonicalPath === null ? null : absoluteUrl(canonicalPath);
const ogImage = absoluteUrl("assets/og-image.png");
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google Consent Mode v2 & Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      var savedConsent = null;
      try {
        savedConsent = localStorage.getItem("glucoluna_cookie_consent");
      } catch (e) {}

      // 1. Regla específica primero: Territorios bajo RGPD (EEE + Reino Unido + Suiza).
      // Bloqueo estricto por defecto hasta que el usuario interactúe con el banner.
      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
        region: [
          "AT", "BE", "BG", "HR", "CY", "CZ", "DK", "EE", "FI", "FR",
          "DE", "GR", "HU", "IS", "IE", "IT", "LV", "LI", "LT", "LU",
          "MT", "NL", "NO", "PL", "PT", "RO", "SK", "SI", "ES", "SE",
          "GB", "CH",
        ],
      });

      // 2. Regla global (resto del mundo fuera del EEE): concedido por defecto.
      gtag("consent", "default", {
        analytics_storage: "granted",
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
      });

      // 3. Si el usuario ya tomó una decisión previa, se envía 'update' inmediatamente
      // en <head> antes de gtag('config') para que Google registre la transición
      // default -> update ('r' si aceptó, 'q' si rechazó) en el parámetro gcd.
      if (savedConsent === "granted" || savedConsent === "denied") {
        gtag("consent", "update", {
          analytics_storage: savedConsent,
          ad_storage: savedConsent,
          ad_user_data: savedConsent,
          ad_personalization: savedConsent,
        });
      }

      gtag("js", new Date());
      gtag("config", "G-PZ3W1DHYWT", {
        anonymize_ip: true,
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PZ3W1DHYWT"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e3a8a" />
    <meta name="robots" content={robots} />
    <meta name="application-name" content="GlucoLuna" />
    <meta name="author" content="Antonio Horrillo (GlucoLuna)" />
    <meta name="generator" content={Astro.generator} />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="GlucoLuna" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GlucoLuna, calendario de glucosa y guía de pinchazo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase("assets/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("assets/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />

    <!-- PWA Service Worker -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <NetworkBar currentProject="glucoluna" />
    <Header active={active} />
    <main id="contenido" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <InstallPrompt />
    <script>
      import "../scripts/ui.js";
    </script>
  </body>
</html>
